# --- 1. Python 环境与缓存 ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# --- 2. 深度学习模型权重 (核心：防止上传几百MB的权重) ---
*.pth
*.pt
*.h5
*.ckpt
*.pb
# 如果你有专门存放权重的文件夹，可以直接忽略整个文件夹
models/checkpoints/
weights/

# --- 3. 数据集 (核心：防止上传海量图片/推文数据) ---
# 忽略所有数据集文件夹
data/
datasets/
# 针对 CrisisMMD 的图片格式
*.jpg
*.jpeg
*.png
*.gif
# 针对标注文件
*.csv
*.json
*.tsv

# --- 4. 日志与输出 ---
logs/
results/
output/
*.log
tensorboard/

# --- 5. IDE 与系统文件 ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 6. Jupyter Notebook 缓存 ---
.ipynb_checkpoints